rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Top-Level /tournaments Collection
    match /tournaments/{tournamentId} {
      // Anyone (participants, spectators, arbiters) can read
      allow read: if true;

      // Authenticated arbiter can create
      allow create: if isSignedIn();

      // Only creator or allowed assistant arbiter can update
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (('ownerEmail' in resource.data) && request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email) ||
        (('allowedEmails' in resource.data) && resource.data.allowedEmails is list && request.auth.token.email != null && request.auth.token.email in resource.data.allowedEmails)
      );

      // Only creator can delete
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (('ownerEmail' in resource.data) && request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email)
      );
    }

    // User Profile Document & personal subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
