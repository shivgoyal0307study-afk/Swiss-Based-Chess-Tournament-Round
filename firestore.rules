rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Top-Level /tournaments Collection
    match /tournaments/{tournamentId} {
      // Anyone (participants, spectators, arbiters) can read
      allow read: if true;

      // Authenticated arbiter can create and update
      allow create, update: if isSignedIn();

      // Only creator, designated arbiter, or Super Admin can delete
      allow delete: if isSignedIn() && (
        request.auth.token.email == 'shivgoyal0307@gmail.com' ||
        resource.data.ownerId == request.auth.uid ||
        (('ownerEmail' in resource.data) && request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email)
      );
    }

    // User Profile Document & personal subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == 'shivgoyal0307@gmail.com');

      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == 'shivgoyal0307@gmail.com');
      }
    }

    // Director Account Approval Requests
    match /director_requests/{userId} {
      // Authenticated users can submit requests and Super Admin can manage approvals
      allow read, write: if isSignedIn();
    }
  }
}
